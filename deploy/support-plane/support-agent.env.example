# Hardened node-local support identity bootstrap.
# Remove the one-time enrollment code from service configuration after enrollment.
PitCrewSupport__Agent__IdentityRoot=<absolute-support-identity-root>
PitCrewSupport__Agent__ReplayRoot=<absolute-support-replay-root>
PitCrewSupport__Agent__PipeName=pitcrew-support-broker-v1
PitCrewSupport__Agent__DashboardUrl=https://dashboard.example.com
PitCrewSupport__Agent__TenantId=<tenant-id>
PitCrewSupport__Agent__DisplayName=<support-node-display-name>
PitCrewSupport__Agent__EnrollmentCode=<one-time-enrollment-code>

# Installer/operator rotation command after enrollment:
#   PitCrew.Support.Agent.App rotate
# Exit 0 = finalized, 2 = safe pending finalization/retry, 1 = failed.

# Legacy/manual compatibility is disabled by default. Enabling it requires the
# previously documented NodeId, RelayUrl, TransportCredential, Dashboard public
# keys, and node PKCS#8 values under the PitCrewSupport__Agent__ prefix.
PitCrewSupport__Agent__AllowLegacyPrivateKeyConfiguration=false

{
  "$schema": "./genesis-delivery.schema.json",
  "schemaVersion": 1,
  "template": "pitcrew-dashboard",
  "defaultBranch": "main",
  "ciWorkflow": "CI",
  "requiredChecks": [
    "CI",
    "PR title",
    "Review policy",
    "Container image"
  ],
  "draftValidation": {
    "hostedDefault": "subset",
    "pitcrewDefault": "subset",
    "subsetJobs": [
      "frontend",
      "build"
    ]
  },
  "runnerProfiles": [],
  "componentWorkflows": [
    {
      "source": "repository",
      "path": ".github/workflows/container-ci.yml",
      "roles": [
        "merge-gate",
        "draft-optional"
      ],
      "draftBehavior": "ready-only",
      "requiredChecks": [
        "Container image"
      ]
    },
    {
      "source": "repository",
      "path": ".github/workflows/publish-container.yml",
      "roles": [
        "release-deploy"
      ],
      "draftBehavior": "not-applicable",
      "requiredChecks": []
    },
    {
      "source": "repository",
      "path": ".github/workflows/publish-host-connector.yml",
      "roles": [
        "release-deploy"
      ],
      "draftBehavior": "not-applicable",
      "requiredChecks": []
    }
  ],
  "pullRequestTitle": {
    "pattern": "^(feat|fix|docs|refactor|test|style|build|ci|chore|perf|revert)(\\([a-z0-9][a-z0-9._/-]*\\))?!?: .+$",
    "maxLength": 72
  },
  "squashMerge": {
    "method": "squash",
    "title": "PR_TITLE",
    "message": "PR_BODY"
  }
}

      "reason": "The refreshed Genesis test stack is below the hard ceiling but still exceeds the preferred target."
    },
    {
      "pattern": "src/**/*.cs",
      "maxLines": 575,
      "maxBytes": 28672,
      "phase": "migration",
      "owner": "ADR-0006 and ncosentino/genesis#408",

  "agents": {
    "path": "AGENTS.md",
    "maxLines": 60,
    "maxBytes": 3072,
    "redirects": {
      "claude": "CLAUDE.md",
      "copilot": ".github/copilot-instructions.md"
    }
  },
  "instructions": {
    "managedRoot": ".github/instructions/genesis",
    "individualReviewThreshold": {
      "lines": 100,
      "bytes": 8192
    },
    "matchedContext": {
      "targetLines": 300,
      "targetBytes": 16384,
      "maxLines": 600,
      "maxBytes": 32768
    },
    "representativePaths": [

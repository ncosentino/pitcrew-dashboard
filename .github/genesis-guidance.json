      "DESIGN.md",
      "Directory.Build.props",
      "Directory.Packages.props",
      "docker-compose.hosted.yml",
      "Dockerfile",
      "docs/README.md",
      "docs/adr/adr-0006-docs-first-agent-guidance.md",
      "docs/adr/adr-0007-browser-ux-evidence-and-design-authority.md",
      "docs/frontend-architecture.md",
      "docs/ux-terminology.md",
      "PitCrew.Dashboard.slnx",
      "PRODUCT.md",
      "README.md",
      "src/Adapters/PitCrew.Dashboard.Adapters.Sqlite.Tests/FleetStorageTestTransactions.cs",
      "src/Adapters/PitCrew.Dashboard.Adapters.Sqlite.Tests/PitCrew.Dashboard.Adapters.Sqlite.Tests.csproj",
      "src/Adapters/PitCrew.Dashboard.Adapters.Sqlite/SqliteConnectionFactory.cs",
      "src/PitCrew.Connector.Features.Sync/ConnectorHealthJournal.cs",
      "src/PitCrew.Dashboard.Features.Fleet/AlertRuleEvaluator.cs",
      "src/PitCrew.Dashboard.WebApi/ClientApp/eslint.config.js",
      "src/PitCrew.Dashboard.WebApi/ClientApp/package.json",
      "src/PitCrew.Dashboard.WebApi/ClientApp/src/core/api/httpClient.test.ts",
      "src/PitCrew.Dashboard.WebApi/ClientApp/src/core/api/httpClient.ts",
      "src/PitCrew.Dashboard.WebApi/ClientApp/src/features/fleet/FleetOverviewPage.tsx",
      "src/PitCrew.Dashboard.WebApi/ClientApp/src/features/fleet/FleetPages.test.tsx",
